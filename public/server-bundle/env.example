# Change JWT_SECRET to a long random string (32+ chars) before starting.
JWT_SECRET=change-me-to-a-long-random-string-please

# Restrict to your Pit Lane origin in production, e.g.
# CORS_ORIGIN=https://pitlane.example.com
CORS_ORIGIN=*

POSTGRES_USER=pitlane
POSTGRES_PASSWORD=pitlane
POSTGRES_DB=pitlane